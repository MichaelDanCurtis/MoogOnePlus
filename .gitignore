.omc/
.DS_Store
__pycache__/
*.pyc
.venv/
# Moog firmware stays out of git. The exception is our own packet captures of
our own instrument: they are the evidence behind docs/arch/*, and a claim
marked [READ] is only worth the bytes someone else can re-read.
captures/*
!captures/modmatrix-wire/
captures/modmatrix-wire/*
!captures/modmatrix-wire/*.pcap
*.wav

# Moog-proprietary material and personal data — never publish.
# See docs/INTERNAL-DO-NOT-DISTRIBUTE.md for what lives here and why.
docs/INTERNAL-DO-NOT-DISTRIBUTE.md
*DO-NOT-DISTRIBUTE*
*.bin

# Effects snapshots are per-instrument and per-session state, not source.
presets/

# Panel photography is Moog's, and belongs to whoever runs this, not to the repo.
src/moogone/vox/static/panel.*
src/moogone/vox/static/moog_one*
src/moogone/vox/static/*.webp
src/moogone/vox/static/PNG image.png
# Generated from the panel photo, which is not in this repo. recon/hotspots.py makes it.
src/moogone/vox/static/hotspots.json

# CLAP plugin build output and fetched third-party headers
plugin/build/
